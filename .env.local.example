# ONA Records — frontend environment template
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_ variables are compiled into the JavaScript bundle at BUILD
# time and shipped to the browser. Two consequences:
#
#   1. Changing one requires a redeploy, not a restart.
#   2. Never put a secret behind that prefix — it is public by definition,
#      readable in the browser's source. Server-only values go without it.

# Where the Django API lives. No trailing slash.
#   local    http://localhost:8000/api/v1
#   staging  https://<backend-staging-domain>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mirrors the backend's health endpoint. Used to show a STAGING marker in
# the UI so nobody mistakes it for production.
NEXT_PUBLIC_ENVIRONMENT=local
